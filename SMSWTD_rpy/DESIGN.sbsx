			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">message = &quot;Selecting dissemination channels&quot;;%0D
std::cout &lt;&lt; message &lt;&lt; std::endl;%0D
%0D
// Set LED states based on alertPriority%0D
if (alertPriority == &quot;HIGH&quot;) {%0D
    sms = true;            %0D
    pushNotification = true; %0D
    govChannels = true;    %0D
    socialMedia = true;    %0D
}%0D
else if (alertPriority == &quot;MEDIUM&quot;) {%0D
    sms = false;          %0D
    pushNotification = true; %0D
    govChannels = true;    %0D
    socialMedia = true;   %0D
}%0D
else if (alertPriority == &quot;LOW&quot;) {%0D
    sms = false;           %0D
    pushNotification = false; %0D
    govChannels = true;    %0D
    socialMedia = true;    %0D
}%0D
%0D
</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
