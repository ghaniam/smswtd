			<_id type="a">GUID dcdc322a-e7a8-4dca-934b-e9a5e04f43aa</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Availability</_name>
			<_modifiedTimeWeak type="a">12.29.2024::11:16:31</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::11:16:58</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 The SMSWTD shall operate 24/7 and handle surges in alert traffic during disaster events.\par%0D
}%0D
</_body>
			<reqID type="a">301</reqID>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID feabb48d-3650-4d18-8516-724fbc01b585</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Performance</_name>
			<_modifiedTimeWeak type="a">12.29.2024::11:16:34</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::11:16:58</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 The SMSWTD shall be able to disseminate alerts on all possible channels.\par%0D
}%0D
</_body>
			<reqID type="a">306</reqID>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID 3f6263d7-d304-443e-b5b7-269fc7a44f16</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Security</_name>
			<_modifiedTimeWeak type="a">12.29.2024::11:16:37</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::11:16:58</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 The SMSWTD shall be encrypted during transmission to ensure data integrity and prevent unauthorized access.\par%0D
}%0D
</_body>
			<reqID type="a">302</reqID>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID d9b75779-505c-4447-b2ac-60e460e4dd56</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Timeliness</_name>
			<_modifiedTimeWeak type="a">12.29.2024::11:16:41</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::11:16:58</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 The SMSWTD shall be able to send alerts via multiple channels within 10 seconds of issuance.\par%0D
}%0D
</_body>
			<reqID type="a">304</reqID>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID c5caafd4-b146-4a8c-9a53-1f27150e8f15</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Usability</_name>
			<_modifiedTimeWeak type="a">12.29.2024::11:16:44</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::11:16:58</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 The system interface shall be easy to use for the operators to configure the communication channels.\par%0D
\par%0D
}%0D
</_body>
			<reqID type="a">303</reqID>
		</IRequirement>
