		<IRequirement type="e">
			<_id type="a">GUID 0fae4878-1094-4f02-83c1-7ae8b00f17d5</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">QualityNFR_SMSWTD</_name>
			<_modifiedTimeWeak type="a">12.29.2024::15:5:41</_modifiedTimeWeak>
			<_modifiedTime type="a">12.29.2024::15:5:41</_modifiedTime>
			<_lastID type="a">1</_lastID>
			<_body type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\ltrpar\fs20 The system must satisfy the timeliness, scalability, availability, accessibility and security concerns.\par%0D
}%0D
</_body>
			<reqID type="a">2</reqID>
			<AggregatesList type="e">
				<value>GUID 43dea2c1-a6c2-42f2-b080-91e8eb4918ea</value>
				<value>GUID 197f1d89-a4a4-43d6-bb1c-d07b45436e49</value>
