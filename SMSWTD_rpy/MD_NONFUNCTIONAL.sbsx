			<_modifiedTime type="a">12.29.2024::15:5:41</_modifiedTime>
			<_body type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\ltrpar\fs20 The SMSWTD shall Support alert dissemination to at least 10 million users simultaneously.\par%0D
\par%0D
\par%0D
\par%0D
\par%0D
}%0D
</_body>
			<reqID type="a">NF4</reqID>
		</IRequirement>
